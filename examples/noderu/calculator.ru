// 🧮 Простой калькулятор

пусть а = 25;
пусть б = 5;

вывод("=== КАЛЬКУЛЯТОР ===");

вывод("Первое число: " + а);
вывод("Второе число: " + б);

вывод("-------------------");

вывод("Сложение:       " + (а + б));
вывод("Вычитание:      " + (а - б));
вывод("Умножение:      " + (а * б));
вывод("Деление:        " + (а / б));
вывод("Остаток:        " + (а % б));
вывод("Степень:        " + Математика.степень(а, б));