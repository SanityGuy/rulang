// Setting the constants
конст аутпут = документ.найтиПоИд("аутпут");
конст полеВвода = документ.найтиПоИд("полеВвода");
конст кнопка = документ.найтиПоИд("кнопка");

// Default text
аутпут.содержимоеХТМЛ = "Введите текст в поле ввода:";

// Click function
кнопка.добавитьСлушателя("клик", функция() {
    конст текст = полеВвода.значение; // Constant of the text
    аутпут.содержимоеХТМЛ = текст; // Setting the output to the text
    полеВвода.значение = ""; // Clearing the input
    вывод("Введенный текст:", текст); // Printing the text to the console (debug output)
});
