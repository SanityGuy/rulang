{
    "Rulang Click Listener": {
        "prefix": "кликСлушатель",
        "body": [
        "${1:кнопка}.добавитьСлушателя(\"клик\", функция() {",
        "    конст текст = ${2:полеВвода}.значение;",
        "    $0",
        "});"
        ],
        "description": "Создает слушатель кликов DOM"
    },
    "Rulang If Statement": {
        "prefix": "если",
        "body": [
        "если (${1:условие}) {",
        "    $0",
        "}"
        ],
        "description": "Условие 'если'"
    },
    "Rulang For Loop": {
        "prefix": "для",
        "body": [
        "для (пусть и = 0; и < ${1:массив}.длина; и++) {",
        "    $0",
        "}"
        ],
        "description": "Цикл 'для' (for loop)"
    },
    "Rulang Function": {
        "prefix": "функция",
        "body": [
        "функция ${1:имяФункции}(${2:аргументы}) {",
        "    $0",
        "}"
        ],
        "description": "Объявление функции"
    },
    "Rulang Console Log": {
        "prefix": "вывод",
        "body": [
        "вывод($1);"
        ],
        "description": "Вывод в консоль"
    },
    "Rulang Fetch API": {
        "prefix": "запроситьАПИ",
        "body": [
        "пусть ответ = ждать запросить(\"${1:https://api.example.com}\");",
        "пусть данные = ждать ответ.разобрать();",
        "вывод(данные);"
        ],
        "description": "Асинхронный запрос к API"
    },
    "Rulang Set Timeout": {
        "prefix": "отложить",
        "body": [
        "отложить(функция() {",
        "    $0",
        "}, ${1:1000});"
        ],
        "description": "Таймер отложенного выполнения"
    }
}